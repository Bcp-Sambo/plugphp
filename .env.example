APP_NAME="PlugPHP"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

# Send the HSTS header (tells browsers to only ever use https:// for this
# host). Turn this on ONLY after https:// is confirmed working on this exact
# domain. Enabling it before the SSL certificate is issued makes the site
# unreachable — the browser refuses plain HTTP and shows no useful error.
FORCE_HSTS=false

DB_HOST=127.0.0.1
DB_NAME=
DB_USER=
DB_PASS=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ENCRYPTION=tls
SMTP_FROM_EMAIL=
SMTP_FROM_NAME="PlugPHP"

# Where contact-form notifications are delivered. Leave blank to fall back
# to SMTP_FROM_EMAIL (the site's own address).
CONTACT_TO=
