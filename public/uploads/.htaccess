# Defense in depth for user-uploaded files (Apache / cPanel hosts).
# Even though core/Upload.php re-encodes every image and strips the execute
# bit, this ensures nothing in this tree is ever handled by the PHP engine.

# Disable any PHP execution here.
<IfModule mod_php.c>
    php_admin_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_admin_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_admin_flag engine off
</IfModule>

# Belt and braces: refuse to run known script handlers as scripts.
<FilesMatch "\.(php|php[0-9]|phtml|phar|pl|py|cgi|sh)$">
    Require all denied
</FilesMatch>
